{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:ssr": "vite build && vite build --ssr",
    "dev": "vite",
    "dev:wa": "concurrently -c \"#93c5fd,#c4b5fd,#22c55e\" \"php -d upload_max_filesize=10M -d post_max_size=12M artisan serve\" \"vite\" \"npm --prefix whatsapp-gateway start\" --names=laravel,vite,wa --kill-others",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "wa:install": "npm install --prefix whatsapp-gateway",
    "wa:start": "npm --prefix whatsapp-gateway start",
    "types:check": "tsc --noEmit",
    "dev:all": "concurrently \"php -d upload_max_filesize=10M -d post_max_size=12M artisan serve\" \"npm run dev\" \"npm run wa:start\"",
    "dev:core": "concurrently \"php -d upload_max_filesize=10M -d post_max_size=12M artisan serve\" \"npm run dev\""
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
